diff --git a/.github/workflows/latest-deps.yml b/.github/workflows/latest-deps.yml
new file mode 100644
index 0000000..c6f5996
--- /dev/null
+++ b/.github/workflows/latest-deps.yml
@@ -0,0 +1,24 @@
+# Once a day the Python tests run on the newest versions of the dependencies. People who
+# install Kitden get those versions, not the ones in uv.lock, so a break shows here first.
+name: Newest dependencies
+
+on:
+  schedule:
+    - cron: "17 5 * * *"
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+jobs:
+  test:
+    runs-on: macos-latest
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          persist-credentials: false
+      - uses: astral-sh/setup-uv@1c37ad07a6a961277cf70c0d37d6f313000f5884 # v10.3.0
+        with:
+          version: "0.10.10"
+      - run: uv sync --upgrade
+      - run: uv run --no-sync pytest -q
