{
  "title": "Findings of an AI reviewer",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "findings"],
  "properties": {
    "summary": {"type": "string"},
    "findings": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "line", "kind", "text"],
        "properties": {
          "path": {"type": "string"},
          "line": {"type": "integer", "minimum": 1},
          "kind": {"type": "string", "enum": ["bug", "rule"]},
          "text": {"type": "string"}
        }
      }
    }
  }
}
